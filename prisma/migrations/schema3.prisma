model Prescription {
  id                String             @id @default(cuid())
  medicalRecordId   String
  consultation      Consultation       @relation(fields: [medicalRecordId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  prescriptionItems PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id])
  quantity       Int
  dosage         String // ex: "1 comprimé 3 fois par jour"
  duration       String // ex: "7 jours"
  instructions   String? // Instructions supplémentaires

  @@map("prescriptionItems")
}

model Medication {
  id                String             @id @default(cuid())
  name              String
  description       String?
  categoryId        String
  category          MedicationCategory @relation(fields: [categoryId], references: [id])
  type              MedicationType
  manufacturer      String
  inStock           Int
  alertThreshold    Int
  expirationDate    DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  prescriptionItems PrescriptionItem[]

  @@map("medications")
}

enum MedicationType {
  SPECIALTY
  GENERIC
}

model MedicationCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  medications Medication[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("medicationCategories")
}

model Room {
  id               String            @id @default(cuid())
  number           String
  type             String
  status           String
  capacity         Int
  hospitalId       String
  hospital         Hospital          @relation(fields: [hospitalId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  hospitalizations Hospitalization[]

  @@unique([number, hospitalId])
  @@map("rooms")
}

model Equipment {
  id              String    @id @default(cuid())
  name            String
  type            String
  status          String
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("equipments")
}

model Hospitalization {
  id             String       @id @default(cuid())
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id])
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  admissionDate  DateTime
  dischargeDate  DateTime?
  reason         String
  status         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  wardRounds     WardRound[]

  @@map("hospitalizations")
}

model Income {
  id          String     @id @default(cuid())
  hospitalId  String
  hospital    Hospital   @relation(fields: [hospitalId], references: [id])
  patientId   String?
  patient     Patient?   @relation(fields: [patientId], references: [id])
  amount      Float
  type        IncomeType
  description String
  date        DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("incomes")
}

enum IncomeType {
  PATIENT_PAYMENT
  EXTERNAL_FUNDING
  DONATION
  OTHER
}

model Expense {
  id          String      @id @default(cuid())
  hospitalId  String
  hospital    Hospital    @relation(fields: [hospitalId], references: [id])
  amount      Float
  type        ExpenseType
  description String
  date        DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("expenses")
}

enum ExpenseType {
  SALARY
  UTILITY
  EQUIPMENT
  MEDICATION
  MAINTENANCE
  TAX
  OTHER
}

model ConsultationFee {
  id           String        @id @default(cuid())
  hospitalId   String
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  name         String
  description  String?
  amount       Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("consultation_fees")
}

model StaffAttendance {
  id       String           @id @default(cuid())
  staff    Staff            @relation(fields: [staffId], references: [id])
  staffId  String
  date     DateTime
  status   AttendanceStatus
  checkIn  DateTime?
  checkOut DateTime?
  note     String?

  @@unique([staffId, date])
  @@map("staffAttendances")
}

//enums 
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  //HOLIDAY
}

// Enum pour le statut des examens paracliniques
