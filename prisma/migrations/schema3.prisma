//tour de salle 
model WardRound {
  id                String          @id @default(cuid())
  hospitalizationId String
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id])
  staffId           String
  staff             Staff           @relation(fields: [staffId], references: [id])
  dateTime          DateTime
  notes             String?
  observations      String?
  vitalSigns        VitalSigns?
  generalSigns      GeneralSigns?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("wardRounds")
}

model Staff {
  id             String            @id @default(cuid())
  firstName      String
  lastName       String
  role           StaffRole
  specialization String?
  email          String            @unique
  phoneNumber    String
  //Contact information
  address        String?
  nationality    String
  experience     Int?
  //Document
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  documents      StaffDocument[]
  schedules      StaffSchedule[]
  appointments   Appointment[]
  consultations  Consultation[]
  // observations    Observation[]
  // receptions      Reception[]
  wardRounds     WardRound[]
  vitalSigns     VitalSigns[]
  attendance     StaffAttendance[]

  @@map("staffs")
}

model StaffDocument {
  id         String       @id @default(cuid())
  staffId    String
  staff      Staff        @relation(fields: [staffId], references: [id])
  type       DocumentType
  title      String
  url        String
  uploadedAt DateTime     @default(now())

  @@index([staffId])
  @@map("staffDocuments")
}

enum DocumentType {
  RESUME
  CERTIFICATE
  ID_PROOF
  QUALIFICATION
  CONTRACT
  OTHER
}

enum StaffRole {
  DOCTOR
  NURSE
  ADMIN
  RECEPTIONIST
  TECHNICIAN
  OTHER
}

model StaffSchedule {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, etc.
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("staffSchedules")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model Appointment {
  id                String          @id @default(cuid())
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id])
  staffId           String
  staff             Staff           @relation(fields: [staffId], references: [id])
  hospitalId        String
  hospital          Hospital        @relation(fields: [hospitalId], references: [id])
  consultationFeeId String
  consultationFee   ConsultationFee @relation(fields: [consultationFeeId], references: [id])
  dateTime          DateTime
  reason            String
  status            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("appointments")
}

model Consultation {
  id               String                    @id @default(cuid())
  patientId        String
  patient          Patient                   @relation(fields: [patientId], references: [id])
  staffId          String
  staff            Staff                     @relation(fields: [staffId], references: [id])
  hospitalId       String
  hospital         Hospital                  @relation(fields: [hospitalId], references: [id])
  chiefComplaintId String
  chiefComplaint   Complaint                 @relation(fields: [chiefComplaintId], references: [id])
  otherComplaints  String?
  antecedents      String? // Antécédents
  historyOfIllness String // Histoire de la maladie
  ca               String? // Complément d'anamnèse
  examinations     ConsultationExamination[]
  treatment        String
  notes            String?
  vitalSigns       VitalSigns?
  generalSigns     GeneralSigns?
  prescriptions    Prescription[]
  hospitalization  Hospitalization?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@map("consultations")
}

// Table de liaison entre Consultation et Examination
model ConsultationExamination {
  id             String            @id @default(cuid())
  consultationId String
  consultation   Consultation      @relation(fields: [consultationId], references: [id])
  examinationId  String
  examination    Examination       @relation(fields: [examinationId], references: [id])
  requestedAt    DateTime          @default(now())
  status         ExaminationStatus @default(REQUESTED)
  notes          String?
  result         String?
  resultDate     DateTime?

  @@unique([consultationId, examinationId])
  @@map("consultationExaminations")
}

model Examination {
  id            String                    @id @default(cuid())
  name          String
  type          ExaminationType
  description   String?
  category      ExaminationCategory? // Pour regrouper les examens similaires
  bodyPart      BodyPart?
  consultations ConsultationExamination[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@map("examinations")
}

// Modèle pour les types d'examen
enum ExaminationType {
  CLINICAL
  PARACLINICAL
