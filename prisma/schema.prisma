// Schema Prisma pour la gestion hospitalière complète

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  address          String
  phoneNumber      String
  email            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  departments      Department[]
  staffSchedules   StaffSchedule[]
  appointments     Appointment[]
  consultations    Consultation[]
  rooms            Room[]
  incomes          Income[]
  users            User[]
  expenses         Expense[]
  consultationFees ConsultationFee[]
  branches         HospitalBranch[]
  admissions       Admission[]
  financialStatistics FinancialStatistics[]
  settings         HospitalSettings[]
  emergencyContacts HospitalEmergencyContact[]
  surgeries        Surgery[]
  invoices         Invoice[]
  labTests         LabTest[]
  medications      Medication[]
  queues           Queue[]
  prescriptions    Prescription[]
  @@map("hospitals")
}

model HospitalBranch {
  id           String   @id @default(cuid())
  hospitalId   String
  name         String
  address      String
  phone        String?
  email        String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  isMainBranch Boolean  @default(false)

  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  users        User[]
  departments  Department[]
  appointments Appointment[]
  consultations Consultation[]
  admissions   Admission[]
  surgeries    Surgery[]
  staffSchedules   StaffSchedule[]
  incomes          Income[]
  expenses         Expense[]
  consultationFees ConsultationFee[]
  // Ajoute ici d'autres relations si besoin (ex: surgeries, invoices, etc.)
  rooms            Room[]
  @@map("hospital_branches")
}
// Utilisateurs du système
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  firstName  String
  lastName   String
  phone      String?
  role       UserRole
  hospitalId String? // Ajoutez ce champ
  branchId   String? // Ajoutez ce champ
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital              Hospital?              @relation(fields: [hospitalId], references: [id]) // Ajoutez cette relation
  branch                HospitalBranch?        @relation(fields: [branchId], references: [id]) // Ajoutez cette relation
  doctor                Doctor?
  nurse                 Nurse?
  receptionist          Receptionist?
  administrator         Administrator?
  pharmacist            Pharmacist?
  labTechnician         LabTechnician?
  accountant            Accountant?
  notifications         Notification[]
  leaves                StaffLeave[]
  leaveApprovals        StaffLeave[]           @relation("LeaveApprover")
  evaluations           StaffEvaluation[]
  evaluationsDone       StaffEvaluation[]      @relation("Evaluator")
  auditLogs             AuditLog[]
  patientAccessLogs     PatientAccessLog[]
  dailyNotes            DailyNote[]
  careTeamAssignments   AdmissionCareTeam[]
  authorizedTransfers   BedTransfer[]
  dischargeInstructions DischargeInstruction[]
  payment               Payment[]
  queueEntry            QueueEntry[]
  assignedQueueEntries  QueueEntry[]  @relation("QueueEntryAssignedTo")
  staffSchedules        StaffSchedule[]
  labTestsOrdered       LabTest[]     @relation("DoctorLabTests")
  labTestsPerformed     LabTest[]     @relation("LabTechnician")
  generalSignsRecorded  GeneralSign[] @relation("NurseGeneralSigns")

  @@map("users")
}

enum UserRole {
  DOCTOR
  NURSE
  RECEPTIONIST
  ADMINISTRATOR
  PHARMACIST
  LAB_TECHNICIAN
  ACCOUNTANT
}

// Patients
model Patient {
  id                        String                     @id @default(cuid())
  fileNumber                String                     @unique // Numéro de dossier médical
  title                     String?
  name                      String
  firstName                 String
  lastName                  String
  dateOfBirth               DateTime
  gender                    Gender
  maritalStatus             MaritalStatus?
  address                   String?
  admissionDate             DateTime?
  phone                     String?
  email                     String?
  profession                String?
  bloodType                 BloodType?
  emergencyContact          String?
  nationality               String?
  category                  PatientCategory           
  subscriptions             PatientSubscription[]
  admissions                Admission[]
  appointments              Appointment[]
  consultations             Consultation[]
  prescriptions             Prescription[]
  labTests                  LabTest[]
  medicalRecords            MedicalRecord[] //stock l'historique complet des dossiers médicaux
  invoices                  Invoice[]
  vitalSigns                VitalSign[]
  generalSigns              GeneralSign[]
  medicationAdministrations MedicationAdministration[]
  surgeries                 Surgery[] //Chirurgie
  queueEntries              QueueEntry[]
  clinicalExaminations      ClinicalExamination[]
  paraclinicalExams         ParaclinicalExam[]
  allergies                 PatientAllergy[]
  medicalHistories          MedicalHistory[]
  vaccinations              Vaccination[]
  consents                  PatientConsent[]
  documents                 PatientDocument[]
  transfers                 PatientTransfer[]
  bedTransfers             BedTransfer[]
  accessLogs                PatientAccessLog[]
  teleconsultations         Teleconsultation[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([category]) // Index sur la catégorie de patient
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum MaritalStatus {
  MARRIED
  SINGLE
  DIVORCED
  WIDOWED
}

// Catégories de patients
enum PatientCategory {
  PRIVATE // Patients payant directement (tarifs standards)
  SUBSCRIBER // Patients abonnés (tarifs préférentiels ou forfaits)
}

// Modèle pour les plans d'abonnement
model SubscriptionPlan {
  id           String  @id @default(cuid())
  name         String
  code         String  @unique
  description  String?
  duration     Int // Durée en mois
  price        Float // Prix de l'abonnement
  renewalPrice Float? // Prix du renouvellement (si différent)

  // Avantages de l'abonnement
  consultationDiscount    Float? // Réduction sur les consultations (%)
  medicationDiscount      Float? // Réduction sur les médicaments (%)
  labTestDiscount         Float? // Réduction sur les analyses (%)
  hospitalizationDiscount Float? // Réduction sur les hospitalisations (%)

  // Limites de l'abonnement
  freeConsultations Int? // Nombre de consultations gratuites
  freeFollowUps     Int? // Nombre de consultations de suivi gratuites

  // Relations
  subscriptions  PatientSubscription[]
  benefitDetails SubscriptionBenefit[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@map("subscription_plan")
}

// Détails des avantages par catégorie de service
model SubscriptionBenefit {
  id                 String          @id @default(cuid())
  subscriptionPlanId String
  serviceCategory    ServiceCategory
  discountPercentage Float? // Réduction en pourcentage
  discountAmount     Float? // Réduction en montant fixe
  freeUnits          Int? // Nombre d'unités gratuites
  maxUnits           Int? // Nombre maximum d'unités avec réduction

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@map("subscription_benefit")
}

// Abonnements des patients
model PatientSubscription {
  id                 String             @id @default(cuid())
  patientId          String
  subscriptionPlanId String
  startDate          DateTime
  endDate            DateTime
  status             SubscriptionStatus @default(ACTIVE)

  // Suivi d'utilisation
  consultationsUsed Int @default(0)
  followUpsUsed     Int @default(0)

  // Paiement
  paymentAmount Float
  paymentDate   DateTime
  paymentMethod PaymentMethod
  receiptNumber String?

  // Relations
  patient          Patient          @relation(fields: [patientId], references: [id])
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  // Audit
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  notes             String?
  invoice           Invoice[]
  Consultation      Consultation[]
  //LabTest           LabTest[]
  Surgery           Surgery[]
  SubscriptionUsage SubscriptionUsage[]

  @@map("patient_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  MOBILE_PAYMENT
  CHECK
}

// Personnel médical - Médecins
model Doctor {
  id                   String                @id @default(cuid())
  userId               String                @unique
  specialization       Specialization
  licenseNumber        String                @unique
  availability         Json? // Horaires de disponibilité
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admittedPatients     Admission[]           @relation("AdmittingDoctor")
  dischargedPatients   Admission[]           @relation("DischargingDoctor")
  departments          DepartmentDoctor[]
  consultations        Consultation[]
  appointments         Appointment[]
  prescriptions        Prescription[]
  surgeries            Surgery[]
  primarySurgeries     Surgery[]             @relation("PrimarySurgeon")
  assistedSurgeries    SurgeryDoctor[]
  teleconsultations    Teleconsultation[]
  clinicalExaminations ClinicalExamination[]
  paraclinicalExams    ParaclinicalExam[]

  // Tarification
  consultationFee Float? // Tarif de base pour une consultation
  followUpFee     Float? // Tarif pour une consultation de suivi
  emergencyFee    Float? // Tarif pour une consultation d'urgence

  // Honoraires par acte
  procedureFees DoctorProcedureFee[]

  @@map("doctors")
}

enum Specialization {
  GENERAL_MEDICINE
  CARDIOLOGY
  DERMATOLOGY
  NEUROLOGY
  PEDIATRICS
  ORTHOPEDICS
  GYNECOLOGY
  OPHTHALMOLOGY
  PSYCHIATRY
  UROLOGY
  ONCOLOGY
  ENDOCRINOLOGY
  GASTROENTEROLOGY
  PULMONOLOGY
  NEPHROLOGY
  RHEUMATOLOGY
  HEMATOLOGY
  INFECTIOUS_DISEASE
  EMERGENCY_MEDICINE
  ANESTHESIOLOGY
  RADIOLOGY
  PATHOLOGY
  SURGERY
}

// Personnel médical - Infirmiers
model Nurse {
  id             String                     @id @default(cuid())
  userId         String                     @unique
  licenseNumber  String                     @unique
  specialization String?
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?                @relation(fields: [departmentId], references: [id])
  vitalSigns     VitalSign[]
  medications    MedicationAdministration[]

  @@map("nurses")
}

// Personnel - Réceptionnistes
model Receptionist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("receptionists")
}

// Personnel - Administrateurs
model Administrator {
  id       String @id @default(cuid())
  userId   String @unique
  position String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("administrators")
}

// Personnel - Pharmaciens
model Pharmacist {
  id                  String                @id @default(cuid())
  userId              String                @unique
  licenseNumber       String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
 // medicationDispensed MedicationDispensed[]

  @@map("pharmacists")
}

// Personnel - Techniciens de laboratoire
model LabTechnician {
  id             String    @id @default(cuid())
  userId         String    @unique
  specialization String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  //labTests       LabTest[]

  @@map("labTechnicians")
}

// Personnel - Comptables
model Accountant {
  id       String    @id @default(uuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("accountants")
}

// Départements de l'hôpital
model Department {
  id          String  @id @default(uuid())
  name        String
  description String?
  location    String? // ex "Bâtiment A, 3ème étage, Aile Est"
  hospitalId  String?
  branchId    String?

  hospital            Hospital?             @relation(fields: [hospitalId], references: [id])
  branch              HospitalBranch?       @relation(fields: [branchId], references: [id])
  doctors             DepartmentDoctor[]
  nurses              Nurse[]
  rooms               Room[]
  queues              Queue[]
  equipment           Equipment[]
  fromTransfers       PatientTransfer[]     @relation("FromDepartment")
  toTransfers         PatientTransfer[]     @relation("ToDepartment")
  admissionStatistics AdmissionStatistics[]
  FinancialStatistics FinancialStatistics[]

  @@map("departments")
}

model DepartmentDoctor {
  departmentId String
  doctorId     String
  assignedDate DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  doctor       Doctor     @relation(fields: [doctorId], references: [id])

  @@id([departmentId, doctorId])
  @@map("department_doctors")
}

// Chambres et lits
model Room {
  id             String       @id @default(uuid())
  roomNumber     String       @unique
  type           RoomType
  capacity       Int
  floor          Int
  isAvailable    Boolean      @default(true)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])
  roomCategory   RoomCategory
  beds           Bed[]
  hopitalId      String?
  branchId       String?
  hospital        Hospital?    @relation(fields: [hopitalId], references: [id]) 
  branch         HospitalBranch? @relation(fields: [branchId], references: [id])  

  @@map("rooms")
}

enum RoomType {
  STANDARD
  SEMI_PRIVATE
  PRIVATE
  ICU
  EMERGENCY
  OPERATING_ROOM
  DELIVERY_ROOM
  NURSERY
  ISOLATION
}

enum RoomCategory {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  EMERGENCY
  OPERATING_ROOM
  DELIVERY_ROOM
  NURSERY
  ISOLATION
}

model Bed {
  id            String        @id @default(uuid())
  bedNumber     String
  isOccupied    Boolean       @default(false)
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  admissions    Admission[]
  fromTransfers PatientTransfer[] @relation("FromBed")
  toTransfers   PatientTransfer[] @relation("ToBed")
  fromBedTransfers BedTransfer[] @relation("FromBed")
  toBedTransfers   BedTransfer[] @relation("ToBed")
  @@unique([roomId, bedNumber])
  @@map("beds")
}

// Admissions hospitalières // Hospitalisation
model Admission {
  id                   String          @id @default(cuid())
  patientId            String
  bedId                String?
  hospitalId           String?
  branchId             String?
  admissionDate        DateTime        @default(now())
  dischargeDate        DateTime?
  admissionReason      String
  admissionType        AdmissionType   @default(REGULAR) // Nouveau champ
  admittedBy           String? // ID du médecin qui a admis le patient
  dischargedBy         String? // ID du médecin qui a donné la sortie
  expectedStayDuration Int? // Durée prévue en jours
  status               AdmissionStatus @default(ACTIVE)
  notes                String?
  diagnosisAtAdmission String? // Diagnostic à l'admission
  diagnosisAtDischarge String? // Diagnostic à la sortie

  // Relations existantes
  hospital    Hospital?                  @relation(fields: [hospitalId], references: [id])
  branch      HospitalBranch?            @relation(fields: [branchId], references: [id])
  patient     Patient                    @relation(fields: [patientId], references: [id])
  bed         Bed?                       @relation(fields: [bedId], references: [id])
  vitalSigns  VitalSign[] @relation("AdmissionVitalSigns")
  generalSigns GeneralSign[]
  medications MedicationAdministration[] @relation("AdmissionMedications")
  surgeries   Surgery[] @relation("AdmissionSurgeries")
  transfers   BedTransfer[] @relation("AdmissionTransfers")
  patientTransfers PatientTransfer[] @relation("AdmissionPatientTransfers")

  // Nouvelles relations
  admittingDoctor       Doctor?               @relation("AdmittingDoctor", fields: [admittedBy], references: [id])
  dischargingDoctor     Doctor?               @relation("DischargingDoctor", fields: [dischargedBy], references: [id])
  dailyNotes            DailyNote[]
  careTeam              AdmissionCareTeam[]
  mealOrders            MealOrder[]
  dischargeInstructions DischargeInstruction?

  // Tarification
  packageId     String?
  dailyRoomRate Float?
  estimatedCost Float?
  finalCost     Float?

  package HospitalizationPackage? @relation(fields: [packageId], references: [id])

  @@index([patientId, admissionDate]) // Index pour rechercher les admissions par patient et date
  @@index([status]) // Index sur le statut
  @@map("admissions")
}

enum AdmissionType {
  EMERGENCY
  REGULAR
  ELECTIVE
  TRANSFER
  OBSERVATION
  DAY_CARE
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
  DECEASED
  LEFT_AGAINST_ADVICE
  ABSCONDED
}

// Rendez-vous
model Appointment {
  id            String            @id @default(cuid())
  patientId     String
  doctorId      String
  hospitalId    String? // Ajoutez ce champ
  branchId      String? // Ajoutez ce champ
  scheduledDate DateTime
  duration      Int // En minutes
  status        AppointmentStatus @default(SCHEDULED)
  reason        String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  hospital Hospital?       @relation(fields: [hospitalId], references: [id]) // Ajoutez cette relation
  branch   HospitalBranch? @relation(fields: [branchId], references: [id]) // Ajoutez cette relation

  patient          Patient           @relation(fields: [patientId], references: [id])
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  consultation     Consultation?
  teleconsultation Teleconsultation?

  @@index([patientId, scheduledDate]) // Index pour rechercher les rendez-vous par patient et date
  @@index([doctorId, scheduledDate]) // Index pour rechercher les rendez-vous par médecin et date
  @@index([status]) // Index sur le statut du rendez-vous
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Consultations médicales
model Consultation {
  id             String   @id @default(cuid())
  patientId      String
  doctorId       String?
  appointmentId  String?  @unique
  hospitalId     String?
  branchId       String?
  date           DateTime @default(now())
  chiefComplaintId String?
  diagnosis      Json? // Changed from String? to Json? for structured diagnosis
  symptoms       String?
  notes          String?
  followUpNeeded Boolean  @default(false)
  followUpDate   DateTime?
  consultationFee Float?
  basePrice       Float?
  appliedPrice    Float?
  discountAmount  Float?
  subscriptionId  String?
  vitalSigns     VitalSign[]
  generalSigns   GeneralSign[]
  clinicalExamination ClinicalExamination[]
  paraclinicalExam    ParaclinicalExam[]
  prescriptions       Prescription[]
  appointment         Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor              Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital            Hospital?    @relation(fields: [hospitalId], references: [id])
  branch              HospitalBranch? @relation(fields: [branchId], references: [id])
  chiefComplaint      ChiefComplaint? @relation(fields: [chiefComplaintId], references: [id])
  subscription        PatientSubscription?  @relation(fields: [subscriptionId], references: [id])
  createdAt           DateTime     @default(now())
  @@index([patientId, date])
  @@index([doctorId, date])
  @@map("consultations")
}

model ChiefComplaint {
  id             String   @id @default(cuid())
  description    String
  slug           String   @unique
  consultations  Consultation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("chief_complaints")
}

model VitalSign {
  id               String        @id @default(cuid())
  patientId        String
  nurseId          String?
  consultationId   String?
  admissionId      String?
  admission        Admission? @relation("AdmissionVitalSigns", fields: [admissionId], references: [id])
  temperature      Float?
  respirationRate  Int?
  height           Float?
  weight           Float?
  pa               Float?
  ta               String?
  ddr              String?
  dpa              String?
  pc               Float?
  imc              Float?
  pas              Float?
  pad              Float?
  fc               Float?
  spo2             Float?
  notes            String?
  recordedAt       DateTime?
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurse            Nurse?        @relation(fields: [nurseId], references: [id], onDelete: Restrict)
  consultation     Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  @@map("vitalsigns")
}

model ClinicalExamination {
  id             String   @id @default(uuid())
  patientId      String
  doctorId       String?
  consultationId String?
  date           DateTime @default(now())
  findings       Json[]
  patient        Patient         @relation(fields: [patientId], references: [id])
  doctor         Doctor?         @relation(fields: [doctorId], references: [id])
  consultation   Consultation?   @relation(fields: [consultationId], references: [id])
  @@map("clinical_examinations")
}

model ParaclinicalExam {
  id             String  @id @default(uuid())
  patientId      String
  doctorId       String?
  consultationId String?
  examType       String
  status         String  @default("REQUESTED")
  priority       String  @default("ROUTINE")
  requestedAt    DateTime  @default(now())
  scheduledAt    DateTime?
  requestReason  String?
  clinicalContext String?
  instructions   String?
  patient        Patient         @relation(fields: [patientId], references: [id])
  doctor         Doctor?         @relation(fields: [doctorId], references: [id])
  consultation   Consultation?   @relation(fields: [consultationId], references: [id])
  @@map("paraclinical_exams")
}

model Prescription {
  id             String   @id @default(cuid())
  patientId      String
  doctorId       String?
  consultationId String?
  hospitalId     String?
  date           DateTime @default(now())
  notes          String?
  medications    PrescriptionMedication[]
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctor         Doctor?      @relation(fields: [doctorId], references: [id])
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  hospital       Hospital?    @relation(fields: [hospitalId], references: [id])
  createdAt      DateTime     @default(now())
  @@map("prescriptions")
}

model PrescriptionMedication {
  id             String   @id @default(cuid())
  prescriptionId String
  medicationId   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication     Medication   @relation(fields: [medicationId], references: [id])
  @@map("prescription_medications")
}

model Medication {
  id                      String   @id @default(cuid())
  name                    String
  form                    String?  // Form of medication (tablet, capsule, etc.)
  supplierId              String?
  hospitalId              String?
  stock                   Int?     @default(0)
  supplier                Supplier? @relation(fields: [supplierId], references: [id])
  hospital                Hospital? @relation(fields: [hospitalId], references: [id])
  prescriptionMedications PrescriptionMedication[]
  inventories             Inventory[]
  administrations         MedicationAdministration[] @relation("MedicationAdministrations")
  @@map("medications")
}

// Fournisseurs
model Supplier {
  id            String  @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  Int? // Délai de paiement en jours

  medications    Medication[]
  inventoryItems Inventory[]

  @@map("suppliers")
}

// Honoraires par acte médical
model DoctorProcedureFee {
  id          String @id @default(uuid())
  doctorId    String
  procedureId String
  fee         Float

  doctor    Doctor           @relation(fields: [doctorId], references: [id])
  procedure MedicalProcedure @relation(fields: [procedureId], references: [id])

  @@unique([doctorId, procedureId])
  @@map("doctor_procedure_fees")
}

// Actes médicaux
model MedicalProcedure {
  id          String              @id @default(uuid())
  code        String              @unique // Code de nomenclature
  name        String
  description String?
  category    String
  complexity  ProcedureComplexity @default(MEDIUM)
  duration    Int? // Durée estimée en minutes

  doctorFees DoctorProcedureFee[]
  @@map("medical_procedures")
}

enum ProcedureComplexity {
  MINOR
  MEDIUM
  MAJOR
  COMPLEX
}

// Forfaits d'hospitalisation
model HospitalizationPackage {
  id             String  @id @default(uuid())
  name           String
  description    String?
  duration       Int // Durée en jours
  roomCategory   RoomCategory
  basePrice        Float
  includedServices String[] // Liste des services inclus
  excludedServices String[] // Liste des services exclus
  effectiveFrom DateTime
  effectiveTo   DateTime?
  Admission    Admission[]
  @@map("hospitalization_packages")
}

// Suivi de l'utilisation des abonnements
model SubscriptionUsage {
  id              String          @id @default(uuid())
  subscriptionId  String
  serviceCategory ServiceCategory
  serviceId       String
  referenceType   String // "Consultation", "LabTest", etc.
  referenceId     String // ID de la consultation, test, etc.
  usageDate       DateTime        @default(now())

  // Relations
  subscription PatientSubscription @relation(fields: [subscriptionId], references: [id])
  service      Service             @relation(fields: [serviceId], references: [id])

  @@map("subscription_usage")
}

// Statistiques financières
model FinancialStatistics {
  id           String   @id @default(uuid())
  hospitalId   String
  departmentId String?
  date         DateTime @default(now())

  // Revenus
  totalRevenue      Float @default(0)
  privateRevenue    Float @default(0)
  subscriberRevenue Float @default(0)

  // Consultations
  consultationCount       Int @default(0)
  privateConsultations    Int @default(0)
  subscriberConsultations Int @default(0)

  // Hospitalisations
  admissionCount       Int @default(0)
  privateAdmissions    Int @default(0)
  subscriberAdmissions Int @default(0)

  // Abonnements
  newSubscriptions     Int   @default(0)
  renewedSubscriptions Int   @default(0)
  subscriptionRevenue  Float @default(0)

  // Relations
  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  @@map("financial_statistics")
}

model StaffSchedule {
  id           String   @id @default(cuid())
  hospitalId   String
  branchId     String?
  userId       String
  startDate    DateTime
  endDate      DateTime
  shiftType    String? // Ex: "Day", "Night", "OnCall"
  notes        String?
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
  @@map("staff_schedules")
}

model Income {
  id           String   @id @default(cuid())
  hospitalId   String
  branchId     String?
  amount       Float
  source       String
  date         DateTime @default(now())
  notes        String?
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])
  @@map("incomes")
}

model Expense {
  id           String   @id @default(cuid())
  hospitalId   String
  branchId     String?
  amount       Float
  category     String
  date         DateTime @default(now())
  notes        String?
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])
  @@map("expenses")
}

model ConsultationFee {
  id           String   @id @default(cuid())
  hospitalId   String
  branchId     String?
  type         String // Ex: "General", "Specialist"
  amount       Float
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])
  @@map("consultation_fees")
}

// Catégories de services (consultation, laboratoire, imagerie, hospitalisation, pharmacie, etc.)
enum ServiceCategory {
  CONSULTATION
  LAB_TEST
  IMAGING
  HOSPITALIZATION
  PHARMACY
  SURGERY
  OTHER
}

// Services individuels (ex: Consultation générale, Bilan sanguin, IRM, Chambre privée, etc.)
model Service {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  description String?
  category    ServiceCategory
  isActive    Boolean        @default(true)

  // Relations
  usages      SubscriptionUsage[]
  @@map("services")
}

model Invoice {
  id                String                @id @default(cuid())
  invoiceNumber     String                @unique
  patientId         String
  hospitalId        String?
  subscriptionId    String?
  accountantId      String?
  dateIssued        DateTime              @default(now())
  dueDate           DateTime?
  totalAmount       Float
  amountPaid        Float                 @default(0)
  status            InvoiceStatus         @default(PENDING)
  paymentMethod     PaymentMethod?
  notes             String?

  // Relations
  patient           Patient               @relation(fields: [patientId], references: [id])
  hospital          Hospital?             @relation(fields: [hospitalId], references: [id])
  subscription      PatientSubscription?  @relation(fields: [subscriptionId], references: [id])
  accountant        Accountant?           @relation(fields: [accountantId], references: [id])

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  PARTIALLY_PAID
  OVERDUE
}

model MedicalRecord {
  id          String   @id @default(cuid())
  patientId   String
  recordType  String
  description String?
  date        DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id])
  @@map("medical_records")
}

model MedicationAdministration {
  id           String      @id @default(cuid())
  patientId    String
  nurseId      String
  medicationId String?
  medication   String      // Keep as string for backward compatibility
  dose         String
  route        String?
  timeGiven    DateTime    @default(now())
  notes        String?
  admissionId  String?
  admission    Admission?  @relation("AdmissionMedications", fields: [admissionId], references: [id])
  patient      Patient     @relation(fields: [patientId], references: [id])
  nurse        Nurse       @relation(fields: [nurseId], references: [id])
  medicationRef Medication? @relation("MedicationAdministrations", fields: [medicationId], references: [id])
  @@map("medication_administrations")
}

model Surgery {
  id                    String               @id @default(cuid())
  patientId             String
  doctorId              String?
  hospitalId            String?
  branchId              String?
  date                  DateTime             @default(now())
  type                  String
  surgeryType           String?
  description           String?
  outcome               String?
  scheduledStart        DateTime?
  actualStart           DateTime?
  actualEnd             DateTime?
  status                String?
  preOpDiagnosis        String?
  postOpDiagnosis       String?
  complications         String?
  notes                 String?
  createdAt             DateTime             @default(now())
  patientSubscriptionId String?
  admissionId           String?
  primarySurgeonId      String?
  
  patient               Patient              @relation(fields: [patientId], references: [id])
  doctor                Doctor?              @relation(fields: [doctorId], references: [id])
  hospital              Hospital?            @relation(fields: [hospitalId], references: [id])
  branch                HospitalBranch?      @relation(fields: [branchId], references: [id])
  patientSubscription   PatientSubscription? @relation(fields: [patientSubscriptionId], references: [id])
  admission             Admission?           @relation("AdmissionSurgeries", fields: [admissionId], references: [id])
  primarySurgeon        Doctor?              @relation("PrimarySurgeon", fields: [primarySurgeonId], references: [id])
  surgeryDoctors        SurgeryDoctor[]

  @@map("surgeries")
}

model QueueEntry {
  id           String    @id @default(cuid())
  patientId    String
  arrivalTime  DateTime  @default(now())
  status       String?
  ticketNumber Int?
  priority     String?   // LOW, MEDIUM, HIGH, URGENT
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  assignedToId String?
  
  patient      Patient   @relation(fields: [patientId], references: [id])
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  queueId      String?
  queue        Queue?    @relation(fields: [queueId], references: [id])
  assignedTo   User?     @relation("QueueEntryAssignedTo", fields: [assignedToId], references: [id])
  
  @@map("queue_entries")
}

model PatientAllergy {
  id            String    @id @default(cuid())
  patientId     String
  allergen      String    // This can be used as allergenType
  reaction      String?
  severity      String?
  diagnosedDate DateTime?
  notes         String?
  isActive      Boolean   @default(true)
  patient       Patient   @relation(fields: [patientId], references: [id])
  @@map("patient_allergies")
}

model MedicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  condition     String    // This can be used as conditionType
  notes         String?
  date          DateTime  @default(now())
  diagnosedDate DateTime?
  createdAt     DateTime  @default(now())
  patient       Patient   @relation(fields: [patientId], references: [id])
  @@map("medical_histories")
}

model Vaccination {
  id         String    @id @default(cuid())
  patientId  String
  vaccine    String
  date       DateTime  @default(now())
  notes      String?
  doseNumber Int?
  createdAt  DateTime  @default(now())
  patient    Patient   @relation(fields: [patientId], references: [id])
  @@map("vaccinations")
}

model PatientConsent {
  id         String   @id @default(cuid())
  patientId  String
  consentType String
  given      Boolean  @default(false)
  date       DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id])
  @@map("patient_consents")
}

model PatientDocument {
  id         String   @id @default(cuid())
  patientId  String
  title      String
  fileUrl    String
  uploadedAt DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id])
  @@map("patient_documents")
}

model PatientTransfer {
  id              String   @id @default(cuid())
  patientId       String
  fromDepartmentId String?
  toDepartmentId   String?
  fromBedId        String?
  toBedId          String?
  transferDate     DateTime @default(now())
  reason           String?
  admissionId String?
  admission   Admission? @relation("AdmissionPatientTransfers", fields: [admissionId], references: [id])
  patient          Patient  @relation(fields: [patientId], references: [id])
  fromDepartment   Department? @relation("FromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment     Department? @relation("ToDepartment", fields: [toDepartmentId], references: [id])
  fromBed          Bed?     @relation("FromBed", fields: [fromBedId], references: [id])
  toBed            Bed?     @relation("ToBed", fields: [toBedId], references: [id])
  @@map("patient_transfers")
}

model SurgeryDoctor {
  surgeryId String
  doctorId  String
  role      String? // e.g. "Surgeon", "Assistant", "Anesthetist"
  surgery   Surgery  @relation(fields: [surgeryId], references: [id])
  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  @@id([surgeryId, doctorId])
  @@map("surgery_doctors")
}

model BedTransfer {
  id              String   @id @default(cuid())
  fromBedId       String?
  toBedId         String?
  patientId       String
  userId         String
  transferDate    DateTime @default(now())
  reason          String?
  admissionId String?
  admission   Admission? @relation("AdmissionTransfers", fields: [admissionId], references: [id])
  fromBed         Bed?     @relation("FromBed", fields: [fromBedId], references: [id])
  toBed           Bed?     @relation("ToBed", fields: [toBedId], references: [id])
  patient         Patient  @relation(fields: [patientId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  @@map("bed_transfers")
}

model Inventory {
  id           String   @id @default(cuid())
  supplierId   String
  medicationId String
  quantity     Int
  unit         String
  receivedAt   DateTime @default(now())
  expiryDate   DateTime?
  notes        String?

  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  medication   Medication @relation(fields: [medicationId], references: [id])

  @@map("inventories")
}

model DailyNote {
  id           String   @id @default(cuid())
  admissionId  String
  authorId     String
  note         String
  createdAt    DateTime @default(now())
  admission    Admission @relation(fields: [admissionId], references: [id])
  author       User      @relation(fields: [authorId], references: [id])
  @@map("daily_notes")
}

model AdmissionCareTeam {
  id           String   @id @default(cuid())
  admissionId  String
  userId       String
  role         String? // e.g. "Nurse", "Doctor", "Specialist"
  admission    Admission @relation(fields: [admissionId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  @@map("admission_care_teams")
}

model MealOrder {
  id           String   @id @default(cuid())
  admissionId  String
  mealType     String // e.g. "Breakfast", "Lunch", "Dinner"
  description  String?
  orderedAt    DateTime @default(now())
  admission    Admission @relation(fields: [admissionId], references: [id])
  @@map("meal_orders")
}

model DischargeInstruction {
  id           String   @id @default(cuid())
  admissionId  String @unique
  instructions String
  createdAt    DateTime @default(now())
  admission    Admission @relation(fields: [admissionId], references: [id])
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  @@map("discharge_instructions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map("notifications")
}

model StaffLeave {
  id            String   @id @default(cuid())
  userId        String
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        String   @default("PENDING")
  approverId    String?
  user          User     @relation(fields: [userId], references: [id])
  approver      User?    @relation("LeaveApprover", fields: [approverId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("staff_leaves")
}

model StaffEvaluation {
  id           String   @id @default(cuid())
  userId       String
  evaluatorId  String
  evaluation   String
  score        Int?
  date         DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  evaluator    User     @relation("Evaluator", fields: [evaluatorId], references: [id])
  @@map("staff_evaluations")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  details     String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  @@map("audit_logs")
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  paymentDate   DateTime @default(now())
  method        PaymentMethod
  reference     String?
  notes         String?
  user          User     @relation(fields: [userId], references: [id])
  @@map("payments")
}
 

model Queue {
  id           String   @id @default(cuid())
  departmentId String
  hospitalId   String?
  name         String
  description  String?
  status       String? // e.g. "OPEN", "CLOSED"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  department   Department @relation(fields: [departmentId], references: [id])
  hospital     Hospital?  @relation(fields: [hospitalId], references: [id])
  entries      QueueEntry[]
  queueConfiguration QueueConfiguration?
  
  @@map("queues")
}

model Equipment {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  type         String?
  serialNumber String?
  status       String? // e.g. "IN_USE", "AVAILABLE", "MAINTENANCE"
  purchaseDate DateTime?
  department   Department @relation(fields: [departmentId], references: [id])
  @@map("equipment")
}

model AdmissionStatistics {
  id           String   @id @default(cuid())
  departmentId String
  date         DateTime @default(now())
  totalAdmissions Int   @default(0)
  totalDischarges Int  @default(0)
  averageLOS      Float @default(0) // Length of stay
  bedOccupancyRate Float @default(0)
  readmissionRate  Float @default(0)
  department   Department @relation(fields: [departmentId], references: [id])
  @@map("admission_statistics")
}

model PatientAccessLog {
  id         String   @id @default(cuid())
  patientId  String
  userId     String
  accessType String
  reason     String?
  accessTime DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  @@map("patient_access_logs")
}

model Teleconsultation {
  id           String   @id @default(cuid())
  patientId    String
  doctorId     String?
  appointmentId String? @unique
  date         DateTime @default(now())
  notes        String?
  patient      Patient  @relation(fields: [patientId], references: [id])
  doctor       Doctor?  @relation(fields: [doctorId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  @@map("teleconsultations")
}

model QueueConfiguration {
  id                    String   @id @default(cuid())
  queueId               String   @unique
  maxCapacity           Int?     @default(50)
  allowWalkIns          Boolean  @default(true)
  estimatedServiceTime  Int?     @default(15) // in minutes
  priorityLevels        String[] @default(["LOW", "MEDIUM", "HIGH", "URGENT"])
  autoAssignment        Boolean  @default(false)
  notificationSettings  Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  queue                 Queue    @relation(fields: [queueId], references: [id])
  
  @@map("queue_configurations")
}

enum QueuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AllergenType {
  FOOD
  MEDICATION
  ENVIRONMENTAL
  CONTACT
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum ConditionType {
  CHRONIC
  ACUTE
  GENETIC
  INFECTIOUS
  AUTOIMMUNE
  MENTAL_HEALTH
  OTHER
}

enum MedicationForm {
  TABLET
  CAPSULE
  LIQUID
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  PATCH
  OTHER
}

// Missing models
model HospitalSettings {
  id         String    @id @default(cuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  key        String
  value      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@unique([hospitalId, key])
}

model HospitalEmergencyContact {
  id         String    @id @default(cuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  role       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LabTest {
  id           String        @id @default(cuid())
  hospitalId   String
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctorId     String?
  doctor       User?         @relation("DoctorLabTests", fields: [doctorId], references: [id])
  technicianId String?
  technician   User?         @relation("LabTechnician", fields: [technicianId], references: [id])
  testName     String
  testType     String
  status       LabTestStatus @default(PENDING)
  orderDate    DateTime      @default(now())
  sampleDate   DateTime?
  resultDate   DateTime?
  results      String?
  notes        String?
  urgency      String?       @default("NORMAL")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GeneralSign {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  consultationId String?
  consultation  Consultation? @relation(fields: [consultationId], references: [id])
  nurseId       String?
  nurse         User?     @relation("NurseGeneralSigns", fields: [nurseId], references: [id])
  admissionId   String?
  admission     Admission? @relation(fields: [admissionId], references: [id])
  temperature   Float?
  respirationRate Int?
  oxygenSaturation Float?
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  heartRate     Int?
  weight        Float?
  height        Float?
  bmi           Float?
  painLevel     Int?
  consciousness String?
  mobility      String?
  notes         String?
  recordedAt    DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum LabTestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum HospitalType {
  PUBLIC
  PRIVATE
  UNIVERSITY
  SPECIALIZED
  EMERGENCY
  CLINIC
}
