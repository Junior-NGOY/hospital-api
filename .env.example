# PostgreSQL (Neon). sslmode=require en cloud.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT — générer des secrets longs (openssl rand -base64 32). Obligatoires en prod.
ACCESS_TOKEN_SECRET="change-me-access"
REFRESH_TOKEN_SECRET="change-me-refresh"

# Railway injecte souvent PORT. Défaut local : 8000.
PORT=8000
